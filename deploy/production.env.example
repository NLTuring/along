# Template only; do not put secrets in chat or source control.
# Copy to production.env on the target server, restrict file permissions.
NODE_ENV=production
APP_ORIGINS=https://YOUR_DOMAIN
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAILS=
# Use generated hex/base64url passwords or percent-encode URI-special characters.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX
S3_ENDPOINT=https://YOUR_PRIVATE_OSS_S3_ENDPOINT
S3_REGION=cn-shanghai
S3_BUCKET=YOUR_PRIVATE_BUCKET
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BAIDU_BROWSER_AK=
BAIDU_SERVER_AK=
# Enable only after user-consented provider testing and cost/privacy review.
AI_PROVIDER=disabled
AI_REQUEST_TIMEOUT_MS=120000
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_MODEL=
DASHSCOPE_ENDPOINT=
DASHSCOPE_ENDPOINT_HOSTS=
DASHSCOPE_RESULT_HOSTS=
DASHSCOPE_EDIT_PROMPT=
# A trusted segmentation service supporting BOTH real and anime people is required.
# Official SegmentBody is not anime-capable and must not be mislabelled as such.
AI_SEGMENT_URL=
AI_SEGMENT_ALLOWED_HOSTS=
AI_SEGMENT_API_KEY=
AI_SEGMENT_ANIME_CAPABLE=false
AI_MASK_REPRESENTATION=grayscale-white-foreground
# These are used only with AI_PROVIDER=http-gateway, not the native DashScope mode.
AI_EDIT_URL=
AI_EDIT_ALLOWED_HOSTS=
AI_API_KEY=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Do not enable DEVELOPMENT_LOCAL or DEV_OTP_DISPLAY in production.
