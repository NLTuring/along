# Copy to server/.env and fill secrets locally. This file is NOT production-ready.
# For credential-free local UI development, use npm run dev:local instead.
NODE_ENV=development
DEVELOPMENT_LOCAL=false
HOST=127.0.0.1
PORT=3001
APP_ORIGINS=http://localhost:4175
SESSION_SECRET=
DEV_OTP_DISPLAY=false
ADMIN_EMAILS=

# Required outside DEVELOPMENT_LOCAL. Provision database/schema, Redis and private bucket.
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=

# Required in production. Secrets must never be committed or sent to the browser.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BAIDU_BROWSER_AK=
BAIDU_SERVER_AK=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Disabled until an entire editing + REAL/ANIME segmentation chain is configured.
# Choices: disabled | aliyun-dashscope | http-gateway
AI_PROVIDER=disabled
AI_REQUEST_TIMEOUT_MS=120000

# Official synchronous DashScope Qwen editing. No model is selected implicitly.
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn-beijing
# Choose a documented model enabled for this region/account, e.g. qwen-image-2.0-pro.
DASHSCOPE_MODEL=
# Blank uses the documented legacy hostname for the chosen region.
# Optional workspace endpoint must use the region's *.maas.aliyuncs.com host,
# the official /api/v1/services/aigc/multimodal-generation/generation path,
# and an exact matching DASHSCOPE_ENDPOINT_HOSTS entry.
DASHSCOPE_ENDPOINT=
DASHSCOPE_ENDPOINT_HOSTS=
# Required exact result hostnames, comma-separated. No wildcard or URL prefixes.
# Confirm from provider docs/deployment; example (Beijing results may vary):
# DASHSCOPE_RESULT_HOSTS=dashscope-result-bj.oss-cn-beijing.aliyuncs.com
DASHSCOPE_RESULT_HOSTS=
# Blank uses the server-owned anime editing prompt. Never supplied by client input.
DASHSCOPE_EDIT_PROMPT=

# REQUIRED additional service: trusted binary PNG segmentation gateway supporting
# both real people AND anime. Aliyun SegmentBody supports real people only and
# does not satisfy this prerequisite. A boolean is an operator capability assertion,
# not a health probe or proof of image quality; verify the service before enabling.
AI_SEGMENT_URL=
AI_SEGMENT_ALLOWED_HOSTS=
AI_SEGMENT_API_KEY=
AI_SEGMENT_ANIME_CAPABLE=false
AI_MASK_REPRESENTATION=grayscale-white-foreground

# Explicit generic gateway alternative, NOT the official DashScope API.
# Only used with AI_PROVIDER=http-gateway. Same separate segmentation prerequisite.
AI_EDIT_URL=
AI_EDIT_ALLOWED_HOSTS=
AI_API_KEY=
